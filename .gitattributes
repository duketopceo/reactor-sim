# Everything text is stored and checked out with LF on every OS. Without this, Windows
# checkouts with core.autocrlf=true flip Unity's YAML (.unity/.asset/.meta) between LF and
# CRLF and show phantom modifications after every Unity batchmode run.
* text=auto eol=lf

# Unity YAML: always text, LF.
*.unity  text eol=lf
*.asset  text eol=lf
*.meta   text eol=lf
*.prefab text eol=lf
*.mat    text eol=lf

# Binary assets and build outputs: never diff, never convert.
*.fbx    binary
*.blend  binary
*.png    binary
*.jpg    binary
*.wav    binary
*.dll    binary
*.pdb    binary
