# Unity-generated IDE projects and per-user editor state (regenerated on every open)
ReactorSim.Unity/*.csproj
ReactorSim.Unity/*.sln
ReactorSim.Unity/*.slnx
ReactorSim.Unity/.vsconfig
ReactorSim.Unity/.vscode/
ReactorSim.Unity/Build/
ReactorSim.Unity/Builds/
ReactorSim.Unity/*.log
ReactorSim.Unity/*.apk
ReactorSim.Unity/*.aab
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/
sysinfo.txt

# Blender and render scratch (previews, autosaves, crash dumps)
Blender/**/*.blend1
Blender/**/*.blend@
